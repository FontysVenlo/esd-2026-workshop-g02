{
  "id": null,
  "uid": "workshop-observability",
  "title": "Workshop Observability",
  "tags": ["chaos-engineering", "workshop"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "User-facing request rate",
      "datasource": { "type": "prometheus", "uid": "workshop-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "sum by (challenge, outcome) (rate(workshop_requests_total[1m]))", "legendFormat": "{{challenge}} · {{outcome}}" }]
    },
    {
      "id": 2, "type": "timeseries", "title": "User-facing p95 latency",
      "datasource": { "type": "prometheus", "uid": "workshop-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, challenge) (rate(workshop_request_duration_seconds_bucket[1m])))", "legendFormat": "{{challenge}}" }]
    },
    {
      "id": 3, "type": "timeseries", "title": "Success rate",
      "datasource": { "type": "prometheus", "uid": "workshop-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "sum by (challenge) (rate(workshop_requests_total{outcome=\"success\"}[1m])) / clamp_min(sum by (challenge) (rate(workshop_requests_total[1m])), 0.001)", "legendFormat": "{{challenge}}" }]
    },
    {
      "id": 4, "type": "timeseries", "title": "Error rate",
      "datasource": { "type": "prometheus", "uid": "workshop-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "sum by (challenge) (rate(workshop_requests_total{outcome=\"error\"}[1m])) / clamp_min(sum by (challenge) (rate(workshop_requests_total[1m])), 0.001)", "legendFormat": "{{challenge}}" }]
    },
    {
      "id": 5, "type": "timeseries", "title": "Dependency call p95 latency",
      "datasource": { "type": "prometheus", "uid": "workshop-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, dependency) (rate(workshop_dependency_call_duration_seconds_bucket[1m])))", "legendFormat": "{{dependency}}" }]
    },
    {
      "id": 6, "type": "timeseries", "title": "Dependency failure rate",
      "datasource": { "type": "prometheus", "uid": "workshop-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "sum by (dependency) (rate(workshop_dependency_calls_total{outcome=\"error\"}[1m]))", "legendFormat": "{{dependency}}" }]
    },
    {
      "id": 7, "type": "timeseries", "title": "Fallback responses",
      "datasource": { "type": "prometheus", "uid": "workshop-prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "sum by (challenge) (rate(workshop_fallbacks_total[1m]))", "legendFormat": "{{challenge}}" }]
    }
  ]
}
