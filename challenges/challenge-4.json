{
  "id": "challenge-4",
  "title": "Mini GameDay",
  "difficulty": "CAPSTONE",
  "scenario": "Users report that the Storefront sometimes becomes slow or unreliable. The operations team does not yet know which dependency is responsible.",
  "objective": "Investigate the incident with monitoring, reproduce one controlled fault, and demonstrate a measured resilience improvement.",
  "trafficEndpoint": "/api/gameday/summary",
  "scenarios": [
    { "id": "inventory-latency", "target": "inventory", "type": "LATENCY", "latencyMs": 1000 },
    { "id": "shipping-unavailable", "target": "shipping", "type": "UNAVAILABLE", "latencyMs": 0 }
  ],
  "faults": [
    { "id": "inventory-latency-500", "label": "Stock response +500 ms", "target": "inventory", "type": "LATENCY", "latencyMs": 500 },
    { "id": "inventory-latency-1000", "label": "Stock response +1000 ms", "target": "inventory", "type": "LATENCY", "latencyMs": 1000 },
    { "id": "inventory-unavailable", "label": "Stock service unavailable", "target": "inventory", "type": "UNAVAILABLE", "latencyMs": 0 },
    { "id": "inventory-timeout", "label": "Stock connection times out", "target": "inventory", "type": "TIMEOUT", "latencyMs": 0 },
    { "id": "shipping-unavailable", "label": "Shipping service unavailable", "target": "shipping", "type": "UNAVAILABLE", "latencyMs": 0 },
    { "id": "shipping-timeout", "label": "Shipping connection times out", "target": "shipping", "type": "TIMEOUT", "latencyMs": 0 }
  ],
  "evaluation": {
    "minimumSamplesPerWindow": 12,
    "baselineMinimumSuccessRate": 0.95,
    "incidentMinimumP95IncreaseMs": 300,
    "incidentMaximumOutageSuccessRate": 0.20,
    "validationMinimumSuccessRate": 0.95,
    "validationMinimumP95ImprovementPercent": 25,
    "validationMaximumOutageP95Ms": 750
  }
}
