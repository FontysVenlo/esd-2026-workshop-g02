{
  "id": "challenge-3",
  "title": "Design an Independent Resilience Experiment",
  "scenario": "A product page depends on stock information. Choose a steady state, introduce a dependency fault, and test whether your own resilience settings keep the page usable.",
  "guidanceLevel": "MINIMAL",
  "traffic": { "endpoint": "/api/experiment/demo-product", "ratePerSecond": 3 },
  "faults": [
    { "id": "latency-500", "label": "Stock response delayed by 500 ms", "type": "LATENCY", "latencyMs": 500 },
    { "id": "latency-1000", "label": "Stock response delayed by 1000 ms", "type": "LATENCY", "latencyMs": 1000 },
    { "id": "latency-1500", "label": "Stock response delayed by 1500 ms", "type": "LATENCY", "latencyMs": 1500 },
    { "id": "unavailable", "label": "Stock service unavailable", "type": "UNAVAILABLE", "latencyMs": 0 }
  ],
  "controls": { "timeoutMs": [4000, 250, 400, 750], "retries": [0, 1], "fallback": true, "circuitBreaker": true },
  "evaluation": {
    "minimumSamplesPerSnapshot": 12,
    "baselineMinSuccessRate": 0.95,
    "latencyMinimumIncreaseMs": 300,
    "unavailableMaximumSuccessRate": 0.20,
    "validationMinimumSuccessRate": 0.95,
    "latencyMinimumP95ImprovementPercent": 25,
    "unavailableMaximumP95Ms": 750,
    "unavailableRequiresFallback": true
  }
}
