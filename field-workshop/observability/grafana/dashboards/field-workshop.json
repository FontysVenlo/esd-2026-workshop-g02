{
  "id": null,
  "uid": "field-workshop",
  "title": "Northstar Supply — service health",
  "tags": [
    "field-workshop",
    "reliability"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 6,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 8,
      "type": "timeseries",
      "title": "Shared workers and queue",
      "datasource": {
        "type": "prometheus",
        "uid": "field-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "workshop_workers_active",
          "legendFormat": "Active workers",
          "interval": "5s"
        },
        {
          "refId": "B",
          "expr": "workshop_workers_queued",
          "legendFormat": "Waiting requests",
          "interval": "5s"
        },
        {
          "refId": "C",
          "expr": "workshop_workers_limit",
          "legendFormat": "Worker limit",
          "interval": "5s"
        }
      ],
      "description": "Real shared worker occupancy, queued product operations and configured limit. Scraped every two seconds; short peaks between scrapes may be missed."
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Rejected since restart",
      "description": "Cumulative rejected product operations. Resets when Storefront restarts. Compare phase changes or the rejection rate.",
      "datasource": {
        "type": "prometheus",
        "uid": "field-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "workshop_capacity_rejections_total",
          "instant": true
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Product p95 latency",
      "datasource": {
        "type": "prometheus",
        "uid": "field-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, sku) (rate(workshop_product_duration_seconds_bucket[1m])))",
          "legendFormat": "{{sku}}",
          "interval": "5s"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Dependency p95 latency",
      "datasource": {
        "type": "prometheus",
        "uid": "field-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, dependency) (rate(workshop_dependency_duration_seconds_bucket[1m])))",
          "legendFormat": "{{dependency}}",
          "interval": "5s"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Dependency outcomes",
      "datasource": {
        "type": "prometheus",
        "uid": "field-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (dependency, outcome) (rate(workshop_dependency_calls_total[1m]))",
          "legendFormat": "{{dependency}} · {{outcome}}",
          "interval": "5s"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Fallback activity",
      "datasource": {
        "type": "prometheus",
        "uid": "field-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (dependency) (rate(workshop_fallbacks_total[1m]))",
          "legendFormat": "{{dependency}}",
          "interval": "5s"
        }
      ]
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Response checks",
      "datasource": {
        "type": "prometheus",
        "uid": "field-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(workshop_shipping_quotes_total{outcome=\"invalid\"}[1m])) / clamp_min(sum(rate(workshop_shipping_quotes_total[1m])), 0.001)",
          "legendFormat": "Shipping: wrong or missing (%)",
          "interval": "5s"
        },
        {
          "refId": "B",
          "expr": "100 * sum(rate(workshop_rejected_quotes_total[1m])) / clamp_min(sum(rate(workshop_shipping_quotes_total[1m])), 0.001)",
          "legendFormat": "Shipping: blocked (%)",
          "interval": "5s"
        },
        {
          "refId": "C",
          "expr": "100 * sum(rate(workshop_inventory_responses_total{dependency=\"lighting-inventory\",outcome=\"invalid\"}[1m])) / clamp_min(sum(rate(workshop_inventory_responses_total{dependency=\"lighting-inventory\"}[1m])), 0.001)",
          "legendFormat": "Lighting stock: wrong or missing (%)",
          "interval": "5s"
        },
        {
          "refId": "D",
          "expr": "100 * sum(rate(workshop_rejected_inventory_responses_total{dependency=\"lighting-inventory\"}[1m])) / clamp_min(sum(rate(workshop_inventory_responses_total{dependency=\"lighting-inventory\"}[1m])), 0.001)",
          "legendFormat": "Lighting stock: blocked (%)",
          "interval": "5s"
        }
      ],
      "description": "Wrong or missing values received, and invalid replies discarded by the response checker. Rejected replies never replace the last valid information."
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Responses rejected",
      "datasource": {
        "type": "prometheus",
        "uid": "field-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "workshop_rejected_inventory_responses_total",
          "legendFormat": "{{dependency}}",
          "interval": "5s"
        },
        {
          "refId": "B",
          "expr": "workshop_rejected_quotes_total",
          "legendFormat": "Shipping · {{provider}}",
          "interval": "5s"
        }
      ],
      "description": "Invalid service replies discarded since Storefront started. Counts rise even when the customer keeps seeing the last valid stock or quote. Validation must be enabled for that service. Counters reset on Storefront restart."
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Product results",
      "datasource": {
        "type": "prometheus",
        "uid": "field-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (sku, outcome) (rate(workshop_product_results_total[1m]))",
          "legendFormat": "{{sku}} · {{outcome}}",
          "interval": "5s"
        }
      ],
      "description": "Actual product outcomes, including queue deadline failures inside catalog responses. A successful catalog HTTP envelope can contain failed products. Capacity means the product never acquired the shared worker; timeout means its dependency attempt exceeded the configured limit."
    },
    {
      "id": 17,
      "type": "row",
      "title": "More diagnostics",
      "collapsed": true,
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 24,
        "h": 1
      },
      "panels": [
        {
          "id": 11,
          "type": "stat",
          "title": "Active workers",
          "description": "Currently occupied workers at the latest scrape. Compare with the worker limit below.",
          "datasource": {
            "type": "prometheus",
            "uid": "field-prometheus"
          },
          "gridPos": {
            "x": 0,
            "y": 36,
            "w": 12,
            "h": 7
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "min": 0,
              "decimals": 0
            },
            "overrides": []
          },
          "options": {
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "fields": "",
              "values": false
            },
            "orientation": "auto",
            "textMode": "auto",
            "colorMode": "value",
            "graphMode": "none"
          },
          "targets": [
            {
              "refId": "A",
              "expr": "workshop_workers_active",
              "instant": true
            }
          ]
        },
        {
          "id": 12,
          "type": "stat",
          "title": "Waiting requests",
          "description": "Product operations waiting for a shared worker at the latest scrape.",
          "datasource": {
            "type": "prometheus",
            "uid": "field-prometheus"
          },
          "gridPos": {
            "x": 12,
            "y": 36,
            "w": 12,
            "h": 7
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "min": 0,
              "decimals": 0
            },
            "overrides": []
          },
          "options": {
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "fields": "",
              "values": false
            },
            "orientation": "auto",
            "textMode": "auto",
            "colorMode": "value",
            "graphMode": "none"
          },
          "targets": [
            {
              "refId": "A",
              "expr": "workshop_workers_queued",
              "instant": true
            }
          ]
        },
        {
          "id": 14,
          "type": "stat",
          "title": "New rejections · last minute (estimate)",
          "description": "Estimated counter increase over the last minute; handles restarts. Use fresh equal windows after each change.",
          "datasource": {
            "type": "prometheus",
            "uid": "field-prometheus"
          },
          "gridPos": {
            "x": 0,
            "y": 43,
            "w": 12,
            "h": 7
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "min": 0,
              "decimals": 0
            },
            "overrides": []
          },
          "options": {
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "fields": "",
              "values": false
            },
            "orientation": "auto",
            "textMode": "auto",
            "colorMode": "value",
            "graphMode": "none"
          },
          "targets": [
            {
              "refId": "A",
              "expr": "increase(workshop_capacity_rejections_total[1m])",
              "instant": true
            }
          ]
        },
        {
          "id": 9,
          "type": "timeseries",
          "title": "Capacity rejection rate",
          "datasource": {
            "type": "prometheus",
            "uid": "field-prometheus"
          },
          "gridPos": {
            "x": 12,
            "y": 43,
            "w": 12,
            "h": 7
          },
          "fieldConfig": {
            "defaults": {
              "unit": "reqps",
              "min": 0,
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "linear",
                "lineWidth": 2,
                "fillOpacity": 0,
                "showPoints": "never",
                "spanNulls": false
              }
            },
            "overrides": []
          },
          "targets": [
            {
              "refId": "A",
              "expr": "rate(workshop_capacity_rejections_total[1m])",
              "legendFormat": "rejected requests",
              "interval": "5s"
            }
          ]
        },
        {
          "id": 10,
          "type": "timeseries",
          "title": "Open product dependency circuits",
          "datasource": {
            "type": "prometheus",
            "uid": "field-prometheus"
          },
          "gridPos": {
            "x": 0,
            "y": 50,
            "w": 12,
            "h": 7
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "min": 0,
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "stepAfter",
                "lineWidth": 2,
                "fillOpacity": 0,
                "showPoints": "never",
                "spanNulls": false
              }
            },
            "overrides": []
          },
          "targets": [
            {
              "refId": "A",
              "expr": "workshop_open_circuits",
              "legendFormat": "paused paths",
              "interval": "5s"
            }
          ],
          "description": "Number of product/dependency circuits paused or probing. See per-path state and retry delay alongside. Latest scrape, not a live countdown."
        },
        {
          "id": 15,
          "type": "timeseries",
          "title": "Dependency circuit state",
          "description": "0 = closed, 1 = paused, 2 = recovery probe in flight. Inventory has a circuit for each product. Shipping has one shared circuit labelled all. Two-second scrapes can miss brief probes.",
          "datasource": {
            "type": "prometheus",
            "uid": "field-prometheus"
          },
          "gridPos": {
            "x": 12,
            "y": 50,
            "w": 12,
            "h": 7
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "min": 0,
              "max": 2,
              "decimals": 0,
              "mappings": [
                {
                  "type": "value",
                  "options": {
                    "0": {
                      "text": "Closed",
                      "color": "green"
                    },
                    "1": {
                      "text": "Paused",
                      "color": "orange"
                    },
                    "2": {
                      "text": "Probing",
                      "color": "blue"
                    }
                  }
                }
              ],
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "stepAfter",
                "fillOpacity": 0,
                "lineWidth": 2,
                "showPoints": "never",
                "spanNulls": false
              }
            },
            "overrides": []
          },
          "targets": [
            {
              "refId": "A",
              "expr": "workshop_circuit_state",
              "legendFormat": "{{sku}} · {{dependency}}",
              "interval": "5s"
            }
          ]
        },
        {
          "id": 16,
          "type": "timeseries",
          "title": "Dependency retry delay",
          "description": "Remaining cooldown at each two-second scrape. Zero means closed, probing, or eligible for a probe; check circuit state. This is sampled data, not a live countdown.",
          "datasource": {
            "type": "prometheus",
            "uid": "field-prometheus"
          },
          "gridPos": {
            "x": 0,
            "y": 57,
            "w": 12,
            "h": 7
          },
          "fieldConfig": {
            "defaults": {
              "unit": "s",
              "min": 0,
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "linear",
                "lineWidth": 2,
                "fillOpacity": 0,
                "showPoints": "never",
                "spanNulls": false
              }
            },
            "overrides": []
          },
          "targets": [
            {
              "refId": "A",
              "expr": "workshop_circuit_retry_seconds",
              "legendFormat": "{{sku}} · {{dependency}}",
              "interval": "5s"
            }
          ]
        },
        {
          "id": 1,
          "type": "timeseries",
          "title": "Customer request rate",
          "datasource": {
            "type": "prometheus",
            "uid": "field-prometheus"
          },
          "gridPos": {
            "x": 12,
            "y": 57,
            "w": 12,
            "h": 7
          },
          "fieldConfig": {
            "defaults": {
              "unit": "reqps",
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "linear",
                "lineWidth": 2,
                "fillOpacity": 0,
                "showPoints": "never",
                "spanNulls": false
              }
            },
            "overrides": []
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum by (route, status) (rate(workshop_http_requests_total{service=\"storefront\"}[1m]))",
              "legendFormat": "{{route}} · {{status}}",
              "interval": "5s"
            }
          ]
        },
        {
          "id": 2,
          "type": "timeseries",
          "title": "Customer-facing p95 latency",
          "datasource": {
            "type": "prometheus",
            "uid": "field-prometheus"
          },
          "gridPos": {
            "x": 0,
            "y": 64,
            "w": 12,
            "h": 7
          },
          "fieldConfig": {
            "defaults": {
              "unit": "s",
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "linear",
                "lineWidth": 2,
                "fillOpacity": 0,
                "showPoints": "never",
                "spanNulls": false
              }
            },
            "overrides": []
          },
          "targets": [
            {
              "refId": "A",
              "expr": "histogram_quantile(0.95, sum by (le, route) (rate(workshop_http_request_duration_seconds_bucket{service=\"storefront\"}[1m])))",
              "legendFormat": "{{route}}",
              "interval": "5s"
            }
          ]
        },
        {
          "id": 3,
          "type": "timeseries",
          "title": "HTTP response success rate",
          "datasource": {
            "type": "prometheus",
            "uid": "field-prometheus"
          },
          "gridPos": {
            "x": 12,
            "y": 64,
            "w": 12,
            "h": 7
          },
          "fieldConfig": {
            "defaults": {
              "unit": "percentunit",
              "min": 0,
              "max": 1,
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "linear",
                "lineWidth": 2,
                "fillOpacity": 0,
                "showPoints": "never",
                "spanNulls": false
              }
            },
            "overrides": []
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum by (route) (rate(workshop_http_requests_total{service=\"storefront\",status=~\"2..\"}[1m])) / clamp_min(sum by (route) (rate(workshop_http_requests_total{service=\"storefront\"}[1m])), 0.001)",
              "legendFormat": "{{route}}",
              "interval": "5s"
            }
          ],
          "description": "HTTP transport status only. The catalog returns HTTP 200 while carrying individual product errors. Use Product results to compare actual live, degraded, timeout and capacity outcomes."
        }
      ]
    }
  ],
  "timepicker": {
    "refresh_intervals": [
      "2s",
      "5s",
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h",
      "2h",
      "1d"
    ]
  }
}
