{
  "id": null,
  "uid": "field-workshop",
  "title": "Northstar Supply — service health",
  "tags": [
    "field-workshop",
    "reliability"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 8,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 11,
      "type": "stat",
      "title": "Active workers",
      "description": "Workers handling product checks now. The workshop has one worker.",
      "datasource": {
        "type": "prometheus",
        "uid": "field-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "workshop_workers_active",
          "instant": true
        }
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Waiting requests",
      "description": "Product checks waiting for a free worker.",
      "datasource": {
        "type": "prometheus",
        "uid": "field-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "workshop_workers_queued",
          "instant": true
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Shared workers and queue",
      "datasource": {
        "type": "prometheus",
        "uid": "field-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "workshop_workers_active",
          "legendFormat": "Active workers",
          "interval": "5s"
        },
        {
          "refId": "B",
          "expr": "workshop_workers_queued",
          "legendFormat": "Waiting requests",
          "interval": "5s"
        },
        {
          "refId": "C",
          "expr": "workshop_workers_limit",
          "legendFormat": "Worker limit",
          "interval": "5s"
        }
      ],
      "description": "Busy workers, waiting requests and the worker limit. Updated every two seconds; short spikes may be missed."
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Rejected since restart",
      "description": "Requests rejected because the worker was busy. Counts since Storefront started; compare the increase during your experiment.",
      "datasource": {
        "type": "prometheus",
        "uid": "field-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "workshop_capacity_rejections_total",
          "instant": true
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Product p95 latency",
      "datasource": {
        "type": "prometheus",
        "uid": "field-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, sku) (rate(workshop_product_duration_seconds_bucket[1m])))",
          "legendFormat": "{{sku}}",
          "interval": "5s"
        }
      ],
      "description": "Estimated time covering 95% of product checks, including time spent waiting for a worker."
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Dependency p95 latency",
      "datasource": {
        "type": "prometheus",
        "uid": "field-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, dependency) (rate(workshop_dependency_duration_seconds_bucket[1m])))",
          "legendFormat": "{{dependency}}",
          "interval": "5s"
        }
      ],
      "description": "Estimated time covering 95% of calls to each service. Does not include waiting for a worker."
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Dependency outcomes",
      "datasource": {
        "type": "prometheus",
        "uid": "field-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (dependency, outcome) (rate(workshop_dependency_calls_total[1m]))",
          "legendFormat": "{{dependency}} · {{outcome}}",
          "interval": "5s"
        }
      ],
      "description": "Service calls per second, grouped by success, failure or timeout. Success does not guarantee correct data."
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Fallback activity",
      "datasource": {
        "type": "prometheus",
        "uid": "field-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (dependency) (rate(workshop_fallbacks_total[1m]))",
          "legendFormat": "{{dependency}}",
          "interval": "5s"
        }
      ],
      "description": "Fallback uses per second: unconfirmed stock or attempts to get a backup Shipping quote."
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Response checks",
      "datasource": {
        "type": "prometheus",
        "uid": "field-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(workshop_shipping_quotes_total{outcome=\"invalid\"}[1m])) / clamp_min(sum(rate(workshop_shipping_quotes_total[1m])), 0.001)",
          "legendFormat": "Shipping: wrong or missing (%)",
          "interval": "5s"
        },
        {
          "refId": "B",
          "expr": "100 * sum(rate(workshop_rejected_quotes_total[1m])) / clamp_min(sum(rate(workshop_shipping_quotes_total[1m])), 0.001)",
          "legendFormat": "Shipping: blocked (%)",
          "interval": "5s"
        },
        {
          "refId": "C",
          "expr": "100 * sum(rate(workshop_inventory_responses_total{dependency=\"lighting-inventory\",outcome=\"invalid\"}[1m])) / clamp_min(sum(rate(workshop_inventory_responses_total{dependency=\"lighting-inventory\"}[1m])), 0.001)",
          "legendFormat": "Lighting stock: wrong or missing (%)",
          "interval": "5s"
        },
        {
          "refId": "D",
          "expr": "100 * sum(rate(workshop_rejected_inventory_responses_total{dependency=\"lighting-inventory\"}[1m])) / clamp_min(sum(rate(workshop_inventory_responses_total{dependency=\"lighting-inventory\"}[1m])), 0.001)",
          "legendFormat": "Lighting stock: blocked (%)",
          "interval": "5s"
        }
      ],
      "description": "Percentage of replies with invalid values, and the percentage blocked by validation."
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Responses rejected",
      "datasource": {
        "type": "prometheus",
        "uid": "field-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "workshop_rejected_inventory_responses_total",
          "legendFormat": "{{dependency}}",
          "interval": "5s"
        },
        {
          "refId": "B",
          "expr": "workshop_rejected_quotes_total",
          "legendFormat": "Shipping · {{provider}}",
          "interval": "5s"
        }
      ],
      "description": "Invalid replies blocked since Storefront started. Counts can rise while customers still see earlier valid values."
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Product results",
      "datasource": {
        "type": "prometheus",
        "uid": "field-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 24,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (sku, outcome) (rate(workshop_product_results_total[1m]))",
          "legendFormat": "{{sku}} · {{outcome}}",
          "interval": "5s"
        }
      ],
      "description": "Live: main-service reply. Degraded: backup, saved or missing information. Capacity: no worker available in time. Timeout: service took too long. Circuit open: call skipped. Failure: other error. HTTP 200 can still contain failed products."
    },
    {
      "id": 17,
      "type": "row",
      "title": "More diagnostics",
      "collapsed": true,
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 24,
        "h": 1
      },
      "panels": [
        {
          "id": 14,
          "type": "stat",
          "title": "New rejections · last minute (estimate)",
          "description": "Estimated number of requests rejected because the worker was busy in the last minute.",
          "datasource": {
            "type": "prometheus",
            "uid": "field-prometheus"
          },
          "gridPos": {
            "x": 0,
            "y": 43,
            "w": 12,
            "h": 7
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "min": 0,
              "decimals": 0
            },
            "overrides": []
          },
          "options": {
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "fields": "",
              "values": false
            },
            "orientation": "auto",
            "textMode": "auto",
            "colorMode": "value",
            "graphMode": "none"
          },
          "targets": [
            {
              "refId": "A",
              "expr": "increase(workshop_capacity_rejections_total[1m])",
              "instant": true
            }
          ]
        },
        {
          "id": 9,
          "type": "timeseries",
          "title": "Capacity rejection rate",
          "datasource": {
            "type": "prometheus",
            "uid": "field-prometheus"
          },
          "gridPos": {
            "x": 12,
            "y": 43,
            "w": 12,
            "h": 7
          },
          "fieldConfig": {
            "defaults": {
              "unit": "reqps",
              "min": 0,
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "linear",
                "lineWidth": 2,
                "fillOpacity": 0,
                "showPoints": "never",
                "spanNulls": false
              }
            },
            "overrides": []
          },
          "targets": [
            {
              "refId": "A",
              "expr": "rate(workshop_capacity_rejections_total[1m])",
              "legendFormat": "rejected requests",
              "interval": "5s"
            }
          ],
          "description": "Requests rejected per second because the worker was busy."
        },
        {
          "id": 10,
          "type": "timeseries",
          "title": "Open product dependency circuits",
          "datasource": {
            "type": "prometheus",
            "uid": "field-prometheus"
          },
          "gridPos": {
            "x": 0,
            "y": 50,
            "w": 12,
            "h": 7
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "min": 0,
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "stepAfter",
                "lineWidth": 2,
                "fillOpacity": 0,
                "showPoints": "never",
                "spanNulls": false
              }
            },
            "overrides": []
          },
          "targets": [
            {
              "refId": "A",
              "expr": "workshop_open_circuits",
              "legendFormat": "paused paths",
              "interval": "5s"
            }
          ],
          "description": "Circuits that have paused calls or are trying a recovery call."
        },
        {
          "id": 15,
          "type": "timeseries",
          "title": "Dependency circuit state",
          "description": "0: normal calls. 1: calls paused. 2: recovery call running. Inventory has one circuit per product; Shipping shares one.",
          "datasource": {
            "type": "prometheus",
            "uid": "field-prometheus"
          },
          "gridPos": {
            "x": 12,
            "y": 50,
            "w": 12,
            "h": 7
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "min": 0,
              "max": 2,
              "decimals": 0,
              "mappings": [
                {
                  "type": "value",
                  "options": {
                    "0": {
                      "text": "Closed",
                      "color": "green"
                    },
                    "1": {
                      "text": "Paused",
                      "color": "orange"
                    },
                    "2": {
                      "text": "Probing",
                      "color": "blue"
                    }
                  }
                }
              ],
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "stepAfter",
                "fillOpacity": 0,
                "lineWidth": 2,
                "showPoints": "never",
                "spanNulls": false
              }
            },
            "overrides": []
          },
          "targets": [
            {
              "refId": "A",
              "expr": "workshop_circuit_state",
              "legendFormat": "{{sku}} · {{dependency}}",
              "interval": "5s"
            }
          ]
        },
        {
          "id": 16,
          "type": "timeseries",
          "title": "Dependency retry delay",
          "description": "Seconds until another recovery call is allowed. Zero does not always mean recovery; check the circuit state.",
          "datasource": {
            "type": "prometheus",
            "uid": "field-prometheus"
          },
          "gridPos": {
            "x": 0,
            "y": 57,
            "w": 12,
            "h": 7
          },
          "fieldConfig": {
            "defaults": {
              "unit": "s",
              "min": 0,
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "linear",
                "lineWidth": 2,
                "fillOpacity": 0,
                "showPoints": "never",
                "spanNulls": false
              }
            },
            "overrides": []
          },
          "targets": [
            {
              "refId": "A",
              "expr": "workshop_circuit_retry_seconds",
              "legendFormat": "{{sku}} · {{dependency}}",
              "interval": "5s"
            }
          ]
        },
        {
          "id": 1,
          "type": "timeseries",
          "title": "Customer request rate",
          "datasource": {
            "type": "prometheus",
            "uid": "field-prometheus"
          },
          "gridPos": {
            "x": 12,
            "y": 57,
            "w": 12,
            "h": 7
          },
          "fieldConfig": {
            "defaults": {
              "unit": "reqps",
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "linear",
                "lineWidth": 2,
                "fillOpacity": 0,
                "showPoints": "never",
                "spanNulls": false
              }
            },
            "overrides": []
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum by (route, status) (rate(workshop_http_requests_total{service=\"storefront\"}[1m]))",
              "legendFormat": "{{route}} · {{status}}",
              "interval": "5s"
            }
          ],
          "description": "Completed customer API requests per second."
        },
        {
          "id": 2,
          "type": "timeseries",
          "title": "Customer-facing p95 latency",
          "datasource": {
            "type": "prometheus",
            "uid": "field-prometheus"
          },
          "gridPos": {
            "x": 0,
            "y": 64,
            "w": 12,
            "h": 7
          },
          "fieldConfig": {
            "defaults": {
              "unit": "s",
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "linear",
                "lineWidth": 2,
                "fillOpacity": 0,
                "showPoints": "never",
                "spanNulls": false
              }
            },
            "overrides": []
          },
          "targets": [
            {
              "refId": "A",
              "expr": "histogram_quantile(0.95, sum by (le, route) (rate(workshop_http_request_duration_seconds_bucket{service=\"storefront\"}[1m])))",
              "legendFormat": "{{route}}",
              "interval": "5s"
            }
          ],
          "description": "Estimated time covering 95% of customer API requests."
        },
        {
          "id": 3,
          "type": "timeseries",
          "title": "HTTP response success rate",
          "datasource": {
            "type": "prometheus",
            "uid": "field-prometheus"
          },
          "gridPos": {
            "x": 12,
            "y": 64,
            "w": 12,
            "h": 7
          },
          "fieldConfig": {
            "defaults": {
              "unit": "percentunit",
              "min": 0,
              "max": 1,
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "linear",
                "lineWidth": 2,
                "fillOpacity": 0,
                "showPoints": "never",
                "spanNulls": false
              }
            },
            "overrides": []
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum by (route) (rate(workshop_http_requests_total{service=\"storefront\",status=~\"2..\"}[1m])) / clamp_min(sum by (route) (rate(workshop_http_requests_total{service=\"storefront\"}[1m])), 0.001)",
              "legendFormat": "{{route}}",
              "interval": "5s"
            }
          ],
          "description": "Percentage of customer API replies with HTTP 200. Individual products may still have errors; check Product results."
        }
      ]
    }
  ],
  "timepicker": {
    "refresh_intervals": [
      "2s",
      "5s",
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h",
      "2h",
      "1d"
    ]
  }
}
