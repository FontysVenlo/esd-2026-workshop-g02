{
  "id": null,
  "uid": "field-workshop",
  "title": "Northstar Supply — service health",
  "tags": [
    "field-workshop",
    "reliability"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 11,
      "type": "stat",
      "title": "Active workers",
      "description": "Currently occupied workers at the latest scrape. Compare with the worker limit below.",
      "datasource": {
        "type": "prometheus",
        "uid": "field-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "workshop_workers_active",
          "instant": true
        }
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Waiting requests",
      "description": "Product operations waiting for a shared worker at the latest scrape.",
      "datasource": {
        "type": "prometheus",
        "uid": "field-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "workshop_workers_queued",
          "instant": true
        }
      ]
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Rejected since restart",
      "description": "Cumulative rejected product operations. Resets when Storefront restarts. Compare phase changes or the rejection rate.",
      "datasource": {
        "type": "prometheus",
        "uid": "field-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "workshop_capacity_rejections_total",
          "instant": true
        }
      ]
    },
    {
      "id": 14,
      "type": "stat",
      "title": "New rejections · last minute (estimate)",
      "description": "Estimated counter increase over the last minute; handles restarts. Use fresh equal windows after each change.",
      "datasource": {
        "type": "prometheus",
        "uid": "field-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(workshop_capacity_rejections_total[1m])",
          "instant": true
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Shared workers and queue",
      "datasource": {
        "type": "prometheus",
        "uid": "field-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "workshop_workers_active",
          "legendFormat": "Active workers"
        },
        {
          "refId": "B",
          "expr": "workshop_workers_queued",
          "legendFormat": "Waiting requests"
        },
        {
          "refId": "C",
          "expr": "workshop_workers_limit",
          "legendFormat": "Worker limit"
        }
      ],
      "description": "Real shared worker occupancy, queued product operations and configured limit. Scraped every five seconds; short peaks between scrapes may be missed."
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Capacity rejection rate",
      "datasource": {
        "type": "prometheus",
        "uid": "field-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(workshop_capacity_rejections_total[1m])",
          "legendFormat": "rejected requests"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Open product dependency circuits",
      "datasource": {
        "type": "prometheus",
        "uid": "field-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "workshop_open_circuits",
          "legendFormat": "paused paths"
        }
      ],
      "description": "Number of product/dependency circuits paused or probing. See per-path state and retry delay alongside. Latest scrape, not a live countdown."
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Dependency circuit state",
      "description": "0 = closed, 1 = paused, 2 = recovery probe in flight. Each product/dependency has its own circuit. Five-second scrapes can miss brief probes.",
      "datasource": {
        "type": "prometheus",
        "uid": "field-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 2,
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Closed",
                  "color": "green"
                },
                "1": {
                  "text": "Paused",
                  "color": "orange"
                },
                "2": {
                  "text": "Probing",
                  "color": "blue"
                }
              }
            }
          ],
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "workshop_circuit_state",
          "legendFormat": "{{sku}} · {{dependency}}"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Dependency retry delay",
      "description": "Remaining cooldown at each five-second scrape. Zero means closed, probing, or eligible for a probe; check circuit state. This is sampled data, not a live countdown.",
      "datasource": {
        "type": "prometheus",
        "uid": "field-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "workshop_circuit_retry_seconds",
          "legendFormat": "{{sku}} · {{dependency}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Product p95 latency",
      "datasource": {
        "type": "prometheus",
        "uid": "field-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, sku) (rate(workshop_product_duration_seconds_bucket[1m])))",
          "legendFormat": "{{sku}}"
        }
      ]
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Customer request rate",
      "datasource": {
        "type": "prometheus",
        "uid": "field-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route, status) (rate(workshop_http_requests_total{service=\"storefront\"}[1m]))",
          "legendFormat": "{{route}} · {{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Customer-facing p95 latency",
      "datasource": {
        "type": "prometheus",
        "uid": "field-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(workshop_http_request_duration_seconds_bucket{service=\"storefront\"}[1m])))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Customer request success rate",
      "datasource": {
        "type": "prometheus",
        "uid": "field-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 36
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(workshop_http_requests_total{service=\"storefront\",status=~\"2..\"}[1m])) / clamp_min(sum by (route) (rate(workshop_http_requests_total{service=\"storefront\"}[1m])), 0.001)",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Dependency outcomes",
      "datasource": {
        "type": "prometheus",
        "uid": "field-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 36
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (dependency, outcome) (rate(workshop_dependency_calls_total[1m]))",
          "legendFormat": "{{dependency}} · {{outcome}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Dependency p95 latency",
      "datasource": {
        "type": "prometheus",
        "uid": "field-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 44
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, dependency) (rate(workshop_dependency_duration_seconds_bucket[1m])))",
          "legendFormat": "{{dependency}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Fallback activity",
      "datasource": {
        "type": "prometheus",
        "uid": "field-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 44
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (dependency) (rate(workshop_fallbacks_total[1m]))",
          "legendFormat": "{{dependency}}"
        }
      ]
    }
  ]
}
